# Copy this file to `.env` (same folder) and fill in your own values.
# Never commit the real `.env` — it is already excluded by .gitignore.
# Write each line as KEY=value — no spaces around "=" and no quotes.

# Free key, issued instantly: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=your_32_character_fred_key

# The SEC asks every automated request to identify itself with a name and email.
# Nothing to register — just type your own name and email.
SEC_USER_AGENT=Your Name your.email@example.com

# News projects (free keys, issued instantly):
#   New York Times Archive API: https://developer.nytimes.com/get-started (enable the Archive API for your app)
NYT_API_KEY=your_nyt_key
#   The Guardian Open Platform: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=your_guardian_key

# Kaggle is NOT configured here. Put your Kaggle API token in ~/.kaggle/access_token
# (Kaggle > Settings > API > Create New Token shows the exact command).
